# 签名材料模板：复制为 keystore.properties 并填真实值（keystore.properties 已 gitignore）。
# 仅 release 签名需要；debug 用 AGP 默认 debug keystore。
# 生成本地密钥库示例：
#   keytool -genkeypair -v -keystore pi-desktop-release.jks -alias pi-desktop \
#     -keyalg RSA -keysize 2048 -validity 10950 -dname "CN=Pi Desktop, O=fellow99"
storeFile=pi-desktop-release.jks
storePassword=CHANGE_ME
keyAlias=pi-desktop
keyPassword=CHANGE_ME
