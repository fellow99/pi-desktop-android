<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 最小权限面（规划 §17 G6）：出网 + 网络状态；不申请任何安装/查询类权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 需求 203（方案 A，G7.1 特例，2026-11-07）：文档/下载工作区根的共享存储授权。
         · MANAGE_EXTERNAL_STORAGE（API 30+ 编辑）＝ All-files 访问，系统设置页显式授予，不自启不静默申请；
         · READ/WRITE_EXTERNAL_STORAGE（maxSdk=29）＝ API 24-29 运行时权限（系统弹窗）；仅 ≤29 生效。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Phase 2（能力清单 §F 第 2 级）：
         · POST_NOTIFICATIONS = 通知运行时权限（API 33+；声明≠授权，授权走 perm.request）；
         · FOREGROUND_SERVICE(_DATA_SYNC) = 前台服务（runtime.keepAlive，normal 级）。
           SAF 不需要任何权限声明（系统选择器授权制）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".PiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 单实例是硬约束（规划 §6.2 ⑰：端口互抢 ⇒ abort） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务（后台常驻/长会话保活；合规红线 G7：无开机自启，仅显式启动） -->
        <service
            android:name=".service.PiForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
