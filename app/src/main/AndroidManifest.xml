<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 最小权限面（规划 §17 G6/G7）：出网 + 网络状态；不申请任何存储/安装/查询类权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phase 2（能力清单 §F 第 2 级）：
         · POST_NOTIFICATIONS = 通知运行时权限（API 33+；声明≠授权，授权走 perm.request）；
         · FOREGROUND_SERVICE(_DATA_SYNC) = 前台服务（runtime.keepAlive，normal 级）。
           SAF 不需要任何权限声明（系统选择器授权制）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".PiApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 单实例是硬约束（规划 §6.2 ⑰：端口互抢 ⇒ abort） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务（后台常驻/长会话保活；合规红线 G7：无开机自启，仅显式启动） -->
        <service
            android:name=".service.PiForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
