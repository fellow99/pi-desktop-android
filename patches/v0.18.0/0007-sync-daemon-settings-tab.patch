+++ b/app/api/sync-daemon/route.ts
@@ -0,0 +1,127 @@
+import { readFile } from "node:fs/promises";
+import { homedir, hostname } from "node:os";
+import { join } from "node:path";
+
+/**
+ * 中枢服务设置 API（嵌入式桌面版：Ark / Android / HOS）。
+ *
+ * 浏览器侧只访问同源 `/api/sync-daemon`；本 route 在服务端读取进程内同步运行时写下的
+ * `<HOME>/.pi-desktop/sync-daemon/control.json`，再用 Bearer 代理到 127.0.0.1 的控制面。
+ * 令牌与端口不出服务端。
+ *
+ * 构建期由 `patches/v0.17.0/…-sync-daemon-settings-tab.patch` 添加；
+ * 标记字符串 `pi-sync-daemon-route-v1` 供各端装配脚本断言构建产物命中。
+ */
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+const ROUTE_MARKER = "pi-sync-daemon-route-v1";
+const CONFIG_PATH = join(homedir(), ".pi-desktop", "sync-daemon.json");
+const CONTROL_PATH = join(homedir(), ".pi-desktop", "sync-daemon", "control.json");
+
+type SyncSettings = {
+  enabled: boolean;
+  hubUrl: string;
+  hostName: string;
+  hubToken: string;
+};
+
+type SyncStatus = {
+  state: "disabled" | "starting" | "running" | "stopped";
+  reason?: string;
+};
+
+type ControlCreds = { port: number; token: string };
+
+function defaults(): SyncSettings {
+  return { enabled: false, hubUrl: "", hostName: hostname(), hubToken: "" };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function settingsFromFile(raw: unknown): SyncSettings | null {
+  if (!isRecord(raw)) return null;
+  const hub = raw.hub;
+  const host = raw.host;
+  if (!isRecord(hub) || typeof hub.url !== "string" || typeof hub.token !== "string") return null;
+  if (!isRecord(host) || typeof host.name !== "string") return null;
+  return {
+    enabled: raw.enabled === true,
+    hubUrl: hub.url,
+    hostName: host.name,
+    hubToken: hub.token,
+  };
+}
+
+async function readJson(file: string): Promise<unknown> {
+  try {
+    return JSON.parse(await readFile(file, "utf8"));
+  } catch {
+    return null;
+  }
+}
+
+async function readSettings(): Promise<SyncSettings> {
+  return settingsFromFile(await readJson(CONFIG_PATH)) ?? defaults();
+}
+
+async function readControl(): Promise<ControlCreds | null> {
+  const raw = await readJson(CONTROL_PATH);
+  if (!isRecord(raw) || typeof raw.port !== "number" || typeof raw.token !== "string") return null;
+  return { port: raw.port, token: raw.token };
+}
+
+async function controlFetch(pathname: string, init?: RequestInit): Promise<Response | null> {
+  const creds = await readControl();
+  if (!creds) return null;
+  try {
+    return await fetch(`http://127.0.0.1:${creds.port}${pathname}`, {
+      ...init,
+      headers: { ...(init?.headers ?? {}), Authorization: `Bearer ${creds.token}` },
+      signal: AbortSignal.timeout(2500),
+    });
+  } catch {
+    return null;
+  }
+}
+
+function json(value: unknown, status = 200): Response {
+  return new Response(JSON.stringify(value), {
+    status,
+    headers: { "Content-Type": "application/json", "x-pi-sync-route": ROUTE_MARKER },
+  });
+}
+
+export async function GET(): Promise<Response> {
+  const response = await controlFetch("/local/status");
+  if (!response || !response.ok) {
+    return json({ settings: await readSettings(), status: { state: "stopped", reason: "同步守护未启动" } });
+  }
+  const data = await response.json().catch(() => null) as { settings?: SyncSettings; status?: SyncStatus } | null;
+  const settings = data?.settings ?? await readSettings();
+  const status: SyncStatus = data?.status ?? { state: "stopped" };
+  return json({ settings, status });
+}
+
+export async function PUT(request: Request): Promise<Response> {
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: "设置数据格式不正确，请重试" }, 400);
+  }
+  const response = await controlFetch("/local/apply", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  });
+  if (!response) return json({ error: "同步守护未启动" }, 503);
+  const data = await response.json().catch(() => null) as { error?: string } | null;
+  if (!response.ok) {
+    return json({ error: typeof data?.error === "string" ? data.error : `HTTP ${response.status}` }, response.status);
+  }
+  return json(data ?? { ok: true });
+}
