diff --git a/lib/android-sandbox-path.ts b/lib/android-sandbox-path.ts
new file mode 100644
index 0000000..8eb63ce
--- /dev/null
+++ b/lib/android-sandbox-path.ts
@@ -0,0 +1,76 @@
+/**
+ * pi-desktop-android（宿主应用）沙箱路径的**别名归一**（对应 ark 的 `lib/hos-sandbox-path.ts`）。
+ *
+ * Android 上指向同一目录的常见写法：
+ *   ① 应用域（`context.filesDir`，也是 HOME 的形态）
+ *        `/data/user/0/<pkg>/files[/…]`
+ *   ② 历史别名（旧文档/部分工具链视角）
+ *        `/data/data/<pkg>/files[/…]`
+ *   ③ 外存别名（adb shell 与文件管理器常用）
+ *        `/sdcard/…` ≡ `/storage/emulated/0/…`
+ *
+ * ②→① 以 HOME 为锚（HOME 由库注入，形如 ①），不硬编码包名；
+ * ③→① 是固定映射（FUSE 布局，幂等：②③形态归一后不再匹配）。
+ *
+ * 三条性质（与 ark 同口径）：
+ *   · **幂等**：归一后的形态不再匹配任何别名规则，重复调用逐字节不变；
+ *   · **可逆**：只重写请求里的路径，不写盘、不缓存；
+ *   · **不猜测**：HOME 不是 ① 形态时 ② 不生效；非 `/sdcard` 前缀时 ③ 不生效，一律原样返回。
+ *
+ * 为什么需要它：`adb shell` 视角的路径（②③）交给 `statSync`/`existsSync` 会 400
+ * `Directory does not exist`，把「合法写法」报成「目录不存在」会误导排查。
+ */
+
+import { homedir } from "os";
+
+/** 编译产物里的稳定标记（`assemble-payload.mjs` 用它断言补丁真的进了载荷）。 */
+export const ANDROID_PATH_ALIAS_MARKER = "pi-android-sandbox-alias";
+
+/** ① 应用域 HOME 形态（HOME 必须正好是这个形态，② 才谈得上映射）。 */
+const ANDROID_DATA_HOME = /^\/data\/user\/0\/([^/]+)\/files\/?$/;
+
+/** ③ `/sdcard` 前缀（外存别名）。 */
+const SDCARD_PREFIX = /^\/sdcard(?=\/|$)/;
+
+function escapeRegExp(text: string): string {
+  return text.replace(/[.*+?^${}()|[\]]/g, "\\$&");
+}
+
+/**
+ * 把 Android 沙箱/外存路径的别名写法归一为应用域形态。
+ *
+ * @param input 调用方给的路径（可能是 ①②③ 或普通路径）
+ * @param home 应用沙箱根（默认 `homedir()`；单测可显式传入）
+ * @returns 改写后的路径；不需要/不能改写时返回**原值**
+ */
+export function normalizeAndroidSandboxPath(input: string, home: string = homedir()): string {
+  if (!input) return input;
+  let out = input;
+
+  // ③ /sdcard/… → /storage/emulated/0/…（幂等：归一后不再匹配）
+  if (SDCARD_PREFIX.test(out)) {
+    out = out.replace(SDCARD_PREFIX, "/storage/emulated/0");
+  }
+
+  // ② /data/data/<pkg>/files → HOME（/data/user/0/<pkg>/files 的历史别名；以 HOME 为锚）
+  const aliasHome = home.replace(/\/+$/, "");
+  const match = ANDROID_DATA_HOME.exec(aliasHome);
+  if (match) {
+    const legacy = new RegExp("^/data/data/" + escapeRegExp(match[1]) + "/files(?=/|$)");
+    if (legacy.test(out)) {
+      out = out.replace(legacy, aliasHome);
+    }
+  }
+  return out;
+}
+
+/**
+ * 给「路径仍然不存在」的 400 加一句**可诊断**的提示：期望形态、收到的形态、
+ * 以及是否做过改写。纯信息，不参与判定。
+ */
+export function describePathForms(received: string, normalized: string): string {
+  const forms = [`received=${received}`, `expected=${normalized}`];
+  if (normalized !== received) forms.push("normalized=android-alias");
+  forms.push(ANDROID_PATH_ALIAS_MARKER);
+  return forms.join(" ");
+}
